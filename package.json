{
  "name": "biotact-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test login.spec.ts",
    "test:browser:email": "playwright test capability.spec.ts",
    "test:browser:catalogue": "playwright test catalogue.spec.ts presentation.spec.ts",
    "test:browser:native": "playwright test catalogue.native.spec.ts",
    "test:browser:guest": "playwright test guest.spec.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.6",
    "vitest": "4.0.15",
    "prettier": "3.7.4"
  }
}
